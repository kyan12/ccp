# =============================================================================
# CodePlane Configuration
# Copy to .env and fill in your values
# =============================================================================

# --- Current intake ownership ---

# Native Hermes Kanban owns all new engineering intake and task state. Linear
# dispatch/polling/sync is retired; do not configure LINEAR_API_KEY or create new
# CCP jobs. This file documents only compatibility settings for the bounded drain.

# --- Coding Agent ---
# Global default for the coding agent used by the tmux worker.
# Precedence (highest wins):  JobPacket.agent  >  repos.json: mapping.agent  >  CCP_AGENT  >  'claude-code'
# Accepted values: 'claude-code' (alias: 'claude'), 'codex' (aliases: 'openai-codex', 'codex-cli').
# See docs/agents.md for the historical per-repo fallback (`agentFallback`).
# CCP_AGENT=

# Per-repo memory (Phase 5a) is configured via `memoryFile` in
# configs/repos.json — there is no env var equivalent. See docs/memory.md.

# Per-agent outage circuits are stored at configs/outage-<agent>.json. A one-time migration
# copies any legacy configs/outage.json into configs/outage-claude-code.json on first read.

# --- Historical notifications (retired) ---
# Native Hermes Kanban owns current lifecycle notifications. The bounded drain
# sends no START/FINAL, remediation, callback, or Discord lifecycle messages.

# --- Bounded PR drain ---
# The drain is read-only and limited to two named historical jobs. Legacy policy
# inputs may still be parsed for old records but cannot enable merge/remediation.
# CCP_PR_REVIEW_ENABLED=true
# CCP_PR_AUTOMERGE=false          # ignored by the read-only watcher
# CCP_PR_MERGE_METHOD=squash      # metadata only; no merge is executed

# --- Vercel Integration (optional) ---
# VERCEL_TOKEN=
# VERCEL_WEBHOOK_SECRET=

# --- Sentry Integration (optional) ---
# SENTRY_AUTH_TOKEN=

# --- Intake Server ---
# CCP_INTAKE_PORT=4318

# --- Supervisor ---
# CCP_MAX_CONCURRENT=1
# CCP_SUPERVISOR_INTERVAL_MS=15000

# --- Post-worker Validation (see docs/validation.md) ---
# Globally disable per-repo static validation (install/typecheck/test/build)
# CCP_VALIDATION_ENABLED=true
# Phase 2b global gate override. When unset, each repo's validation.gate decides.
# Set to true/1/on/yes to gate every repo, or false/0/off/no to disable gating globally.
# CCP_VALIDATION_GATE=

# --- Preview smoke tests (retired compatibility; see docs/smoke.md) ---
# This legacy override is retained only for old records and isolated module tests.
# The bounded PR drain never runs smoke, changes job state, or spawns remediation;
# native Hermes Kanban owns current preview verification and follow-up work.
# CCP_SMOKE_GATE=

# --- Git Identity (for automated commits) ---
# CCP_GIT_USER_NAME=CodePlane
# CCP_GIT_USER_EMAIL=codeplane@localhost
